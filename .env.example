# Copy this file to .env and fill in real values. Never commit the real .env.

# ---------- PostgreSQL (used by docker-compose in Phase 9) ----------
POSTGRES_DB=fintrack
POSTGRES_USER=fintrack
POSTGRES_PASSWORD=change_me

# ---------- Backend ----------
# EF Core / ASP.NET Core reads this via the ConnectionStrings:DefaultConnection key.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=fintrack;Username=fintrack;Password=change_me

# ---------- JWT (Phase 3) ----------
Jwt__Secret=replace_with_a_long_random_secret_at_least_32_chars
Jwt__Issuer=fintrack
Jwt__Audience=fintrack-client
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=7

# ---------- AI / RAG (Phase 8, optional) ----------
# Leave empty to use the deterministic Fake provider (no external calls, CI-safe).
OpenAI__ApiKey=
OpenAI__ChatModel=gpt-4o-mini
OpenAI__EmbeddingModel=text-embedding-3-small
